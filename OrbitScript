-- ==========================================
-- REUSABLE FUNCTIONS FOR VALIDATION & SAVING
-- ==========================================

local function validateKey(inputKey)
    if type(inputKey) ~= "string" or string.sub(inputKey, 1, 11) ~= "FNOFREE_Key" then
        return false
    end

    -- Strict UTC Date matching the website (valid all day long)
    local year = tonumber(os.date("!%Y"))
    local month = tonumber(os.date("!%m")) - 1
    local day = tonumber(os.date("!%d"))
    local dateString = tostring(year) .. "-" .. tostring(month) .. "-" .. tostring(day)
    
    local rawString = playerHWID .. dateString .. "UniSecret123"
    
    local hash = 0
    for i = 1, #rawString do
        local charCode = string.byte(rawString, i)
        hash = (hash * 31 + charCode) % 1000000007
    end
    
    local expectedSuffix = string.format("%08x", hash)
    local expectedKey = "FNOFREE_Key" .. expectedSuffix

    return inputKey == expectedKey
end

local function executeMainScript()
    local success, err = pcall(function()
        loadstring(game:HttpGet("https://raw.githubusercontent.com/Fnnoooo/actualorbittsbscript/refs/heads/main/actualofffical"))()
    end)
    if not success then
        warn("Failed to load main script: " .. tostring(err))
    end
end

-- Function to spawn the "Reset Key" floating controller panel
