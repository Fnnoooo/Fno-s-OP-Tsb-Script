    Title.Size = UDim2.new(0.5, 0, 1, 0)
    Title.Font = Enum.Font.GothamBold
    Title.Text = "Uni Reset Key"
    Title.TextColor3 = Color3.fromRGB(255, 255, 255)
    Title.TextSize = 13
    Title.TextXAlignment = Enum.TextXAlignment.Left

    local CloseBtn = Instance.new("TextButton")
    CloseBtn.Parent = TopBar
    CloseBtn.BackgroundTransparency = 1
    CloseBtn.Position = UDim2.new(0.8, 0, 0.1, 0)
    CloseBtn.Size = UDim2.new(0, 30, 0, 28)
    CloseBtn.Font = Enum.Font.GothamBold
    CloseBtn.Text = "X"
    CloseBtn.TextColor3 = Color3.fromRGB(255, 75, 75)
    CloseBtn.TextSize = 14

    local MinBtn = Instance.new("TextButton")
    MinBtn.Parent = TopBar
    MinBtn.BackgroundTransparency = 1
    MinBtn.Position = UDim2.new(0.62, 0, 0.1, 0)
    MinBtn.Size = UDim2.new(0, 30, 0, 28)
    MinBtn.Font = Enum.Font.GothamBold
    MinBtn.Text = "-"
    MinBtn.TextColor3 = Color3.fromRGB(200, 200, 200)
    MinBtn.TextSize = 16

    local ResetBtn = Instance.new("TextButton")
    ResetBtn.Parent = ResetFrame
    ResetBtn.BackgroundColor3 = Color3.fromRGB(180, 50, 50)
    ResetBtn.Position = UDim2.new(0.1, 0, 0.42, 0)
    ResetBtn.Size = UDim2.new(0.8, 0, 0, 42)
    ResetBtn.Font = Enum.Font.GothamBold
    ResetBtn.Text = "Reset Key"
    ResetBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
    ResetBtn.TextSize = 14
    
    local ResetCorner = Instance.new("UICorner")
    ResetCorner.CornerRadius = UDim.new(0, 6)
    ResetCorner.Parent = ResetBtn

    local dragging, dragInput, dragStart, startPos
    TopBar.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            dragStart = input.Position
            startPos = ResetFrame.Position
            input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then
                    dragging = false
                end
            end)
        end
    end)

    TopBar.InputChanged:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
            dragInput = input
        end
    end)

    UserInputService.InputChanged:Connect(function(input)
        if input == dragInput and dragging then
            local delta = input.Position - dragStart
            ResetFrame.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
        end
    end)

    local minimized = false
    MinBtn.MouseButton1Click:Connect(function()
        minimized = not minimized
        if minimized then
            ResetBtn.Visible = false
            ResetFrame.Size = UDim2.new(0, 220, 0, 35)
        else
            ResetFrame.Size = UDim2.new(0, 220, 0, 130)
            ResetBtn.Visible = true
        end
    end)

    CloseBtn.MouseButton1Click:Connect(function()
        ResetGui:Destroy()
    end)

    -- STRICT RESET ACTION: Completely deletes or wipes the file contents so it is invalid on re-execution
    ResetBtn.MouseButton1Click:Connect(function()
        pcall(function()
            if delfile then
                delfile(fileName)
            elseif writefile then
                writefile(fileName, "INVALID_RESET_KEY_TOKEN")
            end
        end)
        ResetBtn.Text = "Key Reset! Re-execute..."
        task.wait(1)
        ResetGui:Destroy()
        game.Players.LocalPlayer:Kick("Key has been reset! Re-execute the script to show the key system again.")
    end)
end

-- ==========================================
-- AUTO-LOAD / AUTO-BYPASS CHECK
-- ==========================================
if isfile and readfile then
    local bypassSuccess = false
    pcall(function()
        if isfile(fileName) then
            local savedKey = readfile(fileName)
            -- Only bypass if the saved file contains the EXACT valid key math for today
            if validateKey(savedKey) then
                bypassSuccess = true
            end
        end
    end)
    
    if bypassSuccess then
        print("Valid saved key found for today! Loading script and opening Reset Panel...")
        executeMainScript()
        createResetPanel()
        return
    end
end

